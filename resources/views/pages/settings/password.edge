@layouts.settings({ title: 'Passwort ändern' })
  <h2 class="page__title">Passwort ändern</h2>
  <p class="page__description">
    Zur Sicherheit brauchst du dafür dein aktuelles Passwort.
  </p>

  @form({ route: 'password.update', method: 'POST', class: 'auth__form' })
    @field.root({ name: 'currentPassword' })
      @!field.label({ text: 'Aktuelles Passwort' })
      @!input.control({ type: 'password', autocomplete: 'current-password', required: true })
      @!field.error()
    @end

    @field.root({ name: 'password' })
      @!field.label({ text: 'Neues Passwort' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        required: true,
        minlength: 8,
        maxlength: 32,
      })
      <p class="field__hint">Mindestens 8 Zeichen.</p>
      @!field.error()
    @end

    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Neues Passwort bestätigen' })
      @!input.control({ type: 'password', autocomplete: 'new-password', required: true })
      @!field.error()
    @end

    <div>
      @!button({ text: 'Passwort ändern', type: 'submit' })
    </div>
  @end
@end
