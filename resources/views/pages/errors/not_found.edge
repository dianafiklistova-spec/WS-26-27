@layouts.marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: var(--subtle);">
          <span class="dot"></span>
          404
        </span>
      </div>
      <div class="pc-lead"><span>Nicht gefunden.</span> <em>Diese Seite gibt es nicht.</em></div>
      <p class="pc-para">
        Die Seite, die du aufrufen wolltest, existiert nicht oder wurde gelöscht. Prüfe die Adresse oder geh zurück zur Startseite.
      </p>
      <p class="pc-para">
        @link({ route: 'home', class: 'il' })
          Zurück zur Startseite
        @end
      </p>
    </article>
  </div>
@end
