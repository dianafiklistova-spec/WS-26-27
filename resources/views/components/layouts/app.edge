
{{-- Seitentitel der jeweiligen Seite übernehmen --}}
@let(pageTitle = $props.get('title'))

<!DOCTYPE html>
<html
  lang="de"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} – SPOTTED` : 'SPOTTED' }}</title>

    {{-- Globale CSS- und JavaScript-Dateien einbinden --}}
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>

  <body>

    {{-- Gemeinsamer Header für die SPOTTED-Seiten --}}
    <header class="header header--bar">
      <div class="header__inner">

        {{-- Linker Bereich: Logo und Hauptnavigation --}}
        <div class="header__left">
          @!logo({ size: 28 })

          {{-- Hauptnavigation direkt in den Header integrieren --}}
          <nav class="header__nav" aria-label="Hauptnavigation">
            <a href="/">Feed</a>

            {{-- Admin-Bereich nur für Administratoren anzeigen --}}
            @if(auth.user && auth.user.role === 'admin')
              <a href="/admin">Admin-Bereich</a>
            @end
          </nav>
        </div>

        {{-- Rechter Bereich: Aktionen abhängig vom Login-Status --}}
        <div class="header__right">

          @if(auth.user)

            {{-- Navigation für angemeldete Nutzer --}}

            {{-- TODO: Route zum Erstellen eines Spots ergänzen --}}
            <button type="button" class="btn btn--primary" disabled>
              + Spot posten
            </button>

            <a href="/profile">Mein Profil</a>

            {{-- Bestehende Funktionen vorerst beibehalten --}}
            @!themeToggle()

            @link({ route: 'password.edit', class: 'btn btn--ghost btn--sm', 'aria-label': 'Einstellungen' })
              @svg('lucide:settings', { width: 15, height: 15 })
            @end

            {{-- Abmeldung über eine POST-Anfrage --}}
            @form({ route: 'session.destroy', method: 'POST' })
              <button type="submit" class="btn btn--secondary btn--sm">
                Abmelden
              </button>
            @end

          @else

            {{-- Navigation für nicht angemeldete Nutzer --}}
            <a href="/login">Login</a>
            <a href="/signup">Registrieren</a>

            {{-- Gäste müssen sich anmelden, bevor sie einen Spot erstellen --}}
            <a href="/login" class="btn btn--primary">
              + Spot posten
            </a>

          @end

        </div>
      </div>
    </header>

    {{-- Hauptinhalt der jeweiligen Seite --}}
    <main class="app-main">
      {{{ await $slots.main() }}}
    </main>

    {{-- Erfolgs- und Fehlermeldungen anzeigen --}}
    @include('partials/flash_alerts')

  </body>
</html>
