{{--
  Top-level app navigation. Add an entry here for every new area of your
  app, and it shows up in the navigation bar with its active state handled.
--}}
@let(nav = [
  { label: 'Dashboard', route: 'dashboard', icon: 'lucide:house' },
  { label: 'Profil', route: 'profile.show', icon: 'lucide:user' },
])
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="de"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} – SPOTTED` : 'SPOTTED' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--bar">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @!themeToggle()
          @link({ route: 'password.edit', class: 'btn btn--ghost btn--sm', 'aria-label': 'Einstellungen' })
            @svg('lucide:settings', { width: 15, height: 15 })
          @end
          @form({ route: 'session.destroy', method: 'POST' })
            <button type="submit" class="btn btn--secondary btn--sm">
              @svg('lucide:log-out', { width: 15, height: 15 })
              Log out
            </button>
          @end
        </div>
      </div>
    </header>

    <nav class="subnav">
      <div class="subnav__inner">
        @each(item in nav)
          @navLink({ route: item.route, class: 'subnav__item' })
            @if(item.icon)
              @svg(item.icon, { width: 14, height: 14 })
            @end
            {{ item.label }}
          @end
        @end
      </div>
    </nav>


    <main class="app-main">{{{ await $slots.main() }}}</main> {{-- div durch main ersetzt, um den Hauptinhalt der Seite
     semantisch zu kennzeichnen und die Barrierefreiheit zu verbessern. --}}
    @include('partials/flash_alerts')
  </body>
</html>
